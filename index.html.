<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>vipesa.com — live trading</title>
  <!-- Chart.js CDN for the live chart -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    body {
      background: #0b0f17;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    /* main card – mimics ventupesa layout */
    .vipesa-dashboard {
      max-width: 1280px;
      width: 100%;
      background: #131b26;
      border-radius: 32px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.03);
      padding: 24px 24px 24px 24px;
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 20px;
      color: #eef2f6;
    }

    /* ---------- LEFT CHART / LIVE PRICE PANEL ---------- */
    .chart-panel {
      background: #0d141e;
      border-radius: 24px;
      padding: 20px 20px 16px 20px;
      display: flex;
      flex-direction: column;
      border: 1px solid #1f2a36;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.02);
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }

    .panel-header h3 {
      font-size: 15px;
      font-weight: 500;
      letter-spacing: 0.3px;
      color: #9aa9b9;
      text-transform: uppercase;
    }

    .live-badge {
      background: #1f2a36;
      padding: 4px 12px;
      border-radius: 30px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      font-weight: 600;
      color: #b0c0d0;
      letter-spacing: 0.3px;
      border: 1px solid #2d3b4a;
    }

    .live-dot {
      width: 8px;
      height: 8px;
      background: #22c55e;
      border-radius: 50%;
      animation: pulse 1.8s infinite;
      box-shadow: 0 0 10px #22c55e;
    }

    @keyframes pulse {
      0% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(0.9); }
      100% { opacity: 1; transform: scale(1); }
    }

    .price-big {
      font-size: 42px;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: #ffffff;
      line-height: 1;
      margin-bottom: 4px;
      display: flex;
      align-items: baseline;
      gap: 8px;
    }

    .price-big small {
      font-size: 16px;
      font-weight: 500;
      color: #7e8c9e;
      letter-spacing: 0;
    }

    .price-change {
      font-size: 14px;
      color: #22c55e;
      font-weight: 500;
      margin-bottom: 16px;
    }

    .chart-container {
      position: relative;
      height: 180px;
      width: 100%;
      margin-top: 4px;
      margin-bottom: 16px;
    }

    /* chart area */
    #priceChart {
      width: 100% !important;
      height: 100% !important;
    }

    /* bottom statistics row */
    .stats-row {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      border-top: 1px solid #1e2a36;
      padding-top: 14px;
      margin-top: 4px;
    }

    .stat-item {
      display: flex;
      flex-direction: column;
    }

    .stat-label {
      font-size: 11px;
      color: #6a7b8c;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      font-weight: 500;
    }

    .stat-value {
      font-size: 17px;
      font-weight: 600;
      color: #eef2f6;
      margin-top: 2px;
    }

    .stat-value.highlight {
      color: #facc15;
    }

    /* ---------- MIDDLE TRADE PANEL (Balance, stake, percentages) ---------- */
    .trade-panel {
      background: #0d141e;
      border-radius: 24px;
      padding: 20px;
      border: 1px solid #1f2a36;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .balance-box {
      background: #0b1119;
      border-radius: 18px;
      padding: 14px 16px;
      border: 1px solid #25303e;
    }

    .balance-label {
      font-size: 12px;
      color: #7e8c9e;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .balance-amount {
      font-size: 28px;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: -0.01em;
      margin-top: 4px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .balance-amount span {
      font-size: 16px;
      font-weight: 500;
      color: #9aa9b9;
    }

    .price-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 6px 0;
      border-bottom: 1px dashed #1f2a36;
    }

    .price-row:last-of-type {
      border-bottom: none;
    }

    .price-label {
      font-size: 14px;
      color: #9aa9b9;
    }

    .price-value {
      font-size: 18px;
      font-weight: 600;
      color: #eef2f6;
    }

    /* Percentage bar */
    .percentage-block {
      margin-top: 6px;
    }

    .perc-labels {
      display: flex;
      justify-content: space-between;
      font-size: 15px;
      font-weight: 600;
      margin-bottom: 6px;
    }

    .perc-labels .up {
      color: #22c55e;
    }

    .perc-labels .down {
      color: #ef4444;
    }

    .progress-bar {
      width: 100%;
      height: 8px;
      background: #1e2a36;
      border-radius: 100px;
      overflow: hidden;
      display: flex;
    }

    .progress-up {
      height: 100%;
      width: 49%;
      background: linear-gradient(90deg, #22c55e, #16a34a);
      border-radius: 100px 0 0 100px;
    }

    .progress-down {
      height: 100%;
      width: 51%;
      background: linear-gradient(90deg, #ef4444, #dc2626);
      border-radius: 0 100px 100px 0;
    }

    .trade-amount-range {
      display: flex;
      justify-content: space-between;
      font-size: 13px;
      color: #7e8c9e;
      margin-top: 4px;
    }

    /* stake input */
    .stake-block {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 8px;
    }

    .stake-input {
      background: #0b1119;
      border: 1px solid #25303e;
      border-radius: 14px;
      padding: 12px 16px;
      width: 100%;
      color: #ffffff;
      font-size: 16px;
      font-weight: 500;
      outline: none;
      transition: border 0.2s;
    }

    .stake-input:focus {
      border-color: #3b82f6;
    }

    .currency-tag {
      background: #1e2a36;
      border-radius: 12px;
      padding: 12px 16px;
      font-weight: 600;
      color: #b0c0d0;
      font-size: 14px;
      white-space: nowrap;
      border: 1px solid #2d3b4a;
    }

    .action-buttons {
      display: flex;
      gap: 12px;
      margin-top: 4px;
    }

    .btn-up, .btn-down {
      flex: 1;
      padding: 14px 0;
      border: none;
      border-radius: 18px;
      font-weight: 700;
      font-size: 17px;
      cursor: default;
      letter-spacing: 0.3px;
      transition: all 0.1s ease;
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
      text-align: center;
    }

    .btn-up {
      background: linear-gradient(145deg, #22c55e, #15803d);
      color: white;
    }

    .btn-down {
      background: linear-gradient(145deg, #ef4444, #b91c1c);
      color: white;
    }

    /* ---------- RIGHT CHAT / WITHDRAWALS PANEL ---------- */
    .chat-panel {
      background: #0d141e;
      border-radius: 24px;
      padding: 20px 16px 16px 16px;
      border: 1px solid #1f2a36;
      display: flex;
      flex-direction: column;
      height: 100%;
      min-height: 480px;
    }

    .chat-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      padding: 0 4px;
    }

    .chat-header h3 {
      font-size: 15px;
      font-weight: 600;
      color: #eef2f6;
      letter-spacing: 0.3px;
    }

    .online-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      background: #1e2a36;
      padding: 4px 12px;
      border-radius: 30px;
      font-size: 12px;
      font-weight: 600;
      color: #b0c0d0;
      border: 1px solid #2d3b4a;
    }

    .online-dot {
      width: 8px;
      height: 8px;
      background: #22c55e;
      border-radius: 50%;
      animation: pulse 1.8s infinite;
    }

    .chat-messages {
      flex: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding-right: 6px;
      margin-bottom: 12px;
      max-height: 380px;
      min-height: 280px;
      scrollbar-width: thin;
      scrollbar-color: #2a3746 #0b1119;
    }

    .chat-messages::-webkit-scrollbar {
      width: 4px;
    }

    .chat-messages::-webkit-scrollbar-track {
      background: #0b1119;
      border-radius: 10px;
    }

    .chat-messages::-webkit-scrollbar-thumb {
      background: #2a3746;
      border-radius: 10px;
    }

    .message {
      background: #0b1119;
      border-radius: 14px;
      padding: 10px 14px;
      font-size: 13px;
      line-height: 1.4;
      border-left: 3px solid #3b82f6;
      color: #cbd5e1;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
      border: 1px solid #1e2a36;
    }

    .message .system {
      font-weight: 600;
      color: #facc15;
      margin-right: 6px;
    }

    .message .check {
      color: #22c55e;
      margin-left: 6px;
    }

    .chat-login {
      background: #0b1119;
      border-radius: 16px;
      padding: 14px;
      text-align: center;
      border: 1px solid #25303e;
      font-size: 14px;
      color: #9aa9b9;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: default;
    }

    .chat-login .icon {
      font-size: 18px;
    }

    .win-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #0b1119;
      border-radius: 18px;
      padding: 10px 14px;
      margin-top: 10px;
      border: 1px solid #2d3b4a;
      font-size: 13px;
      color: #eef2f6;
      justify-content: space-between;
    }

    .win-amount {
      color: #22c55e;
      font-weight: 700;
    }

    .verified {
      font-size: 11px;
      color: #6a7b8c;
      background: #1a2532;
      padding: 4px 10px;
      border-radius: 20px;
    }

    /* global currency badge */
    .global-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #1e2a36;
      padding: 4px 12px;
      border-radius: 30px;
      font-size: 11px;
      font-weight: 600;
      color: #b0c0d0;
      border: 1px solid #2d3b4a;
      margin-left: 8px;
    }

    /* responsive */
    @media (max-width: 1000px) {
      .vipesa-dashboard {
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }
      .chat-panel {
        grid-column: span 2;
        min-height: auto;
      }
      .chat-messages {
        max-height: 240px;
        min-height: 180px;
      }
    }

    @media (max-width: 650px) {
      .vipesa-dashboard {
        grid-template-columns: 1fr;
        padding: 16px;
      }
      .chat-panel {
        grid-column: span 1;
      }
      .price-big {
        font-size: 32px;
      }
    }
  </style>
</head>
<body>
  <div class="vipesa-dashboard">

    <!-- LEFT: chart / live price -->
    <div class="chart-panel">
      <div class="panel-header">
        <h3>Market · KES</h3>
        <div class="live-badge">
          <span class="live-dot"></span> LIVE
        </div>
      </div>

      <div class="price-big">
        9751.64 <small>KES</small>
      </div>
      <div class="price-change">▲ +1.24% today</div>

      <div class="chart-container">
        <canvas id="priceChart"></canvas>
      </div>

      <div class="stats-row">
        <div class="stat-item">
          <span class="stat-label">24h high</span>
          <span class="stat-value">9812.20</span>
        </div>
        <div class="stat-item">
          <span class="stat-label">24h low</span>
          <span class="stat-value">9620.50</span>
        </div>
        <div class="stat-item">
          <span class="stat-label">Volume</span>
          <span class="stat-value highlight">1.2M</span>
        </div>
        <div class="stat-item">
          <span class="stat-label">Global</span>
          <span class="stat-value">KES</span>
        </div>
      </div>
    </div>

    <!-- MIDDLE: trade interface -->
    <div class="trade-panel">
      <div class="balance-box">
        <div class="balance-label">
          <span>Balance</span>
          <span style="color: #22c55e; font-weight: 600;">●</span>
        </div>
        <div class="balance-amount">
          KSh 129,000.00
        </div>
      </div>

      <div class="price-row">
        <span class="price-label">Price</span>
        <span class="price-value">9751.64</span>
      </div>

      <div class="percentage-block">
        <div class="perc-labels">
          <span class="up">49%</span>
          <span class="down">51%</span>
        </div>
        <div class="progress-bar">
          <div class="progress-up" style="width:49%"></div>
          <div class="progress-down" style="width:51%"></div>
        </div>
      </div>

      <div class="trade-amount-range">
        <span>Trade amount</span>
        <span>KSh 100 – KSh 50,000</span>
      </div>

      <div class="stake-block">
        <input class="stake-input" type="text" value="100.00" readonly>
        <span class="currency-tag">KSh</span>
      </div>

      <div class="price-row" style="margin-top: 4px; border-bottom: none;">
        <span class="price-label">Live price</span>
        <span class="price-value" style="font-size: 16px;">9751.64</span>
      </div>
      <div class="price-row" style="border-bottom: none; padding-top: 0;">
        <span class="price-label">Stake</span>
        <span class="price-value" style="font-size: 16px;">KSh 100.00</span>
      </div>

      <div class="action-buttons">
        <div class="btn-up">UP</div>
        <div class="btn-down">DOWN</div>
      </div>

      <!-- small global indicator like original -->
      <div style="display: flex; justify-content: flex-end; margin-top: 6px;">
        <span class="global-badge">🌍 Global KES · 46% / 54%</span>
      </div>
    </div>

    <!-- RIGHT: live chat / withdrawals -->
    <div class="chat-panel">
      <div class="chat-header">
        <h3>Live Chat</h3>
        <div class="online-badge">
          <span class="online-dot"></span> 2,341 Online
        </div>
      </div>

      <div class="chat-messages" id="chatMessages">
        <!-- messages will be injected via JS (same style as ventupesa) -->
      </div>

      <div class="chat-login">
        <span class="icon">🔒</span> Login to join the chat
      </div>

      <div class="win-badge">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span style="font-size: 18px;">✨</span>
          <span><strong>Grace A.</strong> won</span>
        </div>
        <div style="display: flex; align-items: center; gap: 10px;">
          <span class="win-amount">+$ 84.81</span>
          <span class="verified">Verified</span>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function() {
      // ---------- 1. CHART ----------
      const ctx = document.getElementById('priceChart').getContext('2d');
      
      // generate some smooth price data
      const points = 30;
      const labels = Array.from({ length: points }, (_, i) => i);
      const basePrice = 9751.64;
      let priceData = [];
      let current = basePrice - 50;
      for (let i = 0; i < points; i++) {
        // gentle upward trend + noise
        current += (Math.random() - 0.48) * 20;
        if (i === points - 1) current = basePrice; // end exactly at current price
        priceData.push(current);
      }

      // gradient fill
      const gradient = ctx.createLinearGradient(0, 0, 0, 200);
      gradient.addColorStop(0, 'rgba(34, 197, 94, 0.25)');
      gradient.addColorStop(1, 'rgba(34, 197, 94, 0.0)');

      new Chart(ctx, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [{
            data: priceData,
            borderColor: '#22c55e',
            borderWidth: 2.5,
            pointRadius: 0,
            pointHoverRadius: 0,
            tension: 0.4,
            fill: true,
            backgroundColor: gradient,
            spanGaps: true
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: { enabled: false }
          },
          scales: {
            x: { display: false },
            y: { display: false }
          },
          elements: {
            line: { borderJoinStyle: 'round' }
          },
          layout: { padding: 0 },
          animation: { duration: 0 }
        }
      });

      // ---------- 2. LIVE CHAT MESSAGES (mock withdrawal feed) ----------
      const chatContainer = document.getElementById('chatMessages');

      const names = ['Nduta', 'Tabby', 'Njeri', 'Otieno', 'Mutua', 'Chebet', 'Akinyi', 'Nyanchera', 'Korir', 'Wanjiku', 'Kavutha', 'Mwangi', 'Obuya', 'Adhiambo', 'Kamau'];
      
      function generateRandomWithdrawal() {
        const name = names[Math.floor(Math.random() * names.length)];
        const amount = (Math.random() * 110 + 5).toFixed(2);
        return { name, amount };
      }

      // pre-fill with 20 messages like ventupesa, using the given names/amounts
      const fixedMessages = [
        { name: 'Nduta', amount: '81.78' },
        { name: 'Tabby', amount: '24.42' },
        { name: 'Nduta', amount: '41.09' },
        { name: 'Tabby', amount: '49.61' },
        { name: 'Njeri', amount: '110.47' },
        { name: 'Otieno', amount: '36.43' },
        { name: 'Njeri', amount: '9.30' },
        { name: 'Mutua', amount: '43.41' },
        { name: 'Chebet', amount: '95.35' },
        { name: 'Akinyi', amount: '73.26' },
        { name: 'Nyanchera', amount: '94.57' },
        { name: 'Korir', amount: '28.29' },
        { name: 'Nyanchera', amount: '14.34' },
        { name: 'Wanjiku', amount: '5.81' },
        { name: 'Kavutha', amount: '78.29' },
        { name: 'Kavutha', amount: '61.63' },
        { name: 'Mwangi', amount: '10.47' },
        { name: 'Mutua', amount: '53.88' },
        { name: 'Nduta', amount: '39.53' },
        { name: 'Obuya', amount: '85.66' }
      ];

      function createMessageElement(name, amount) {
        const div = document.createElement('div');
        div.className = 'message';
        div.innerHTML = `<span class="system">System:</span> ${name} has successfully withdrawn $ ${amount}. Congratulations! <span class="check">✅</span>`;
        return div;
      }

      // add fixed messages
      fixedMessages.forEach(m => {
        chatContainer.appendChild(createMessageElement(m.name, m.amount));
      });

      // then add some extra random ones to fill the list (like ventupesa has many)
      for (let i = 0; i < 15; i++) {
        const { name, amount } = generateRandomWithdrawal();
        chatContainer.appendChild(createMessageElement(name, amount));
      }

      // auto-scroll to bottom (simulate live feed)
      chatContainer.scrollTop = chatContainer.scrollHeight;

      // add a new message every 8-15 seconds to simulate activity
      setInterval(() => {
        const { name, amount } = generateRandomWithdrawal();
        const newMsg = createMessageElement(name, amount);
        chatContainer.appendChild(newMsg);
        // keep only last 30 messages to avoid clutter (like real chat)
        if (chatContainer.children.length > 30) {
          chatContainer.removeChild(chatContainer.firstChild);
        }
        chatContainer.scrollTop = chatContainer.scrollHeight;
      }, 10000 + Math.random() * 5000);
    })();
  </script>
</body>
</html>
